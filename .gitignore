# =====================
# Unity + Visual Studio
# =====================

# Folders generated automatically by Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset store tools
Assets/AssetStoreTools*

# Unity crash reports
sysinfo.txt

# Autogenerated Visual Studio / Rider files
.vs/
.idea/
*.suo
*.user
*.userprefs
*.csproj
*.pidb
*.sln
*.unityproj
*.booproj
*.svd
*.tmp
*.pdb
*.mdb

# JetBrains Rider
.gradle/
*.iml

# Unity Cloud build
/[Bb]uilds/

# Package manager and cache
Packages/packages-lock.json

# Exclude VS temporary build results
[Bb]in/
[Oo]bj/

# Auto-generated project files (recreate when needed)
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Lightmaps, GI, and baked data
LightmapSnapshot/
LightingData.asset
*/Lightmap-*
*/ReflectionProbe-*

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Builds (optional, you can unignore if you want them in Git)
*.apk
*.aab
*.xcodeproj/
*.xcworkspace/

# =====================
# Optional keepers
# =====================

# Keep project metadata
!.gitignore
!.vsconfig
!*.sln
!Assembly-CSharp.csproj
!Assembly-CSharp-Editor.csproj
!ProjectSettings/
!Packages/
!Assets/

# End of file
